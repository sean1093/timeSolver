{
  "name": "timesolver",
  "version": "2.0.0",
  "description": "Tiny immutable date utilities for JavaScript and TypeScript: format, parse, validate and compare native Date objects with one token grammar. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Sean Chou (https://github.com/sean1093)",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/timesolver.global.js",
  "jsdelivr": "./dist/timesolver.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check:exports": "attw --pack . && publint",
    "size": "size-limit",
    "smoke": "node scripts/smoke.mjs",
    "release": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "date",
    "time",
    "datetime",
    "timestamp",
    "format",
    "parse",
    "validate",
    "immutable",
    "typescript",
    "zero-dependency",
    "tree-shakable",
    "dayjs-alternative",
    "profiler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sean1093/timeSolver.git"
  },
  "bugs": {
    "url": "https://github.com/sean1093/timeSolver/issues"
  },
  "homepage": "https://github.com/sean1093/timeSolver#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.3.11",
    "@changesets/cli": "^3.0.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "publint": "^0.3.14",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
